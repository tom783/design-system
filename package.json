{
  "name": "@commerce-ds/root",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "node docs/research/tokens-build.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:clean": "node scripts/typecheck-clean.mjs",
    "verify": "pnpm tokens && pnpm mcp:build && pnpm typecheck && pnpm test && pnpm build-storybook --quiet",
    "mcp": "node packages/mcp/server.mjs",
    "mcp:build": "node docs/research/mcp-build.mjs",
    "qa": "node docs/qa/run-all.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "gate": "pnpm verify && pnpm qa",
    "build": "pnpm --filter @s2life/tokens build && pnpm --filter @s2life/mcp build && pnpm --filter @s2life/ui build",
    "version:set": "node scripts/version-set.mjs",
    "qa:pack": "node docs/qa/pack-verify.mjs",
    "test": "node --test packages/ui/src/lib/*.test.mjs packages/ui/src/components/*/*.test.mjs packages/mcp/*.test.mjs docs/qa/*.test.mjs"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "pretendard": "1.3.9",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ]
}
