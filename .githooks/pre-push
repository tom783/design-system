#!/bin/sh
# 전체 게이트 — 스토리북 빌드 + 브라우저 하네스 전부.
# 급하면 `git push --no-verify` 로 건너뛸 수 있지만,
# 그러면 CI 가 대신 잡는다 (.github/workflows/verify.yml → pnpm gate).
set -e
cd "$(git rev-parse --show-toplevel)"

# 태그만 보내는 푸시는 코드를 바꾸지 않는다. 게이트를 돌릴 이유가 없다 —
# 그 커밋은 이미 통과했고 CI 도 녹색이다. git 이 stdin 으로 주는 ref 를 읽어 판별한다.
# (형식: <local ref> <local sha> <remote ref> <remote sha>)
refs="$(cat)"
if [ -n "$refs" ] && ! printf '%s\n' "$refs" | awk '{print $3}' | grep -qv '^refs/tags/'; then
  printf '\033[33m⚠ 태그만 푸시합니다 — 게이트를 건너뜁니다.\033[0m\n'
  exit 0
fi

# 깨끗한 체크아웃(빌드 산출물 없음)에서 typecheck — 약 5초.
# 로컬의 오래된 dist 덕에 통과하고 CI 에서만 깨지는 것을 여기서 막는다
# (R31~R43b 원격 CI 11회 연속 실패의 원인). 보내는 커밋 그 자체를 검사한다.
shas="$(printf '%s\n' "$refs" | awk '$3 !~ /^refs\/tags\// && $2 !~ /^0+$/ {print $2}' | sort -u)"
[ -n "$shas" ] || shas="$(git rev-parse HEAD)"
for sha in $shas; do
  node scripts/typecheck-clean.mjs "$sha" || { printf '\n\033[31m✗ 깨끗한 체크아웃 typecheck 실패\033[0m\n'; exit 1; }
done

# verify 는 어떤 경우에도 돈다. 3초짜리를 건너뛸 이유가 없고,
# 토큰 대비·MCP drift·타입이 여기서 걸린다.
pnpm -s verify || { printf '\n\033[31m✗ pnpm verify 실패\033[0m\n'; exit 1; }

# 건너뛸 수 있는 것은 느린 브라우저 검증뿐이다.
if [ "$SKIP_QA" = "1" ]; then
  printf '\033[33m⚠ SKIP_QA=1 — 브라우저 검증을 건너뜁니다. CI 가 대신 돌립니다.\033[0m\n'
  exit 0
fi

# 워크플로(.github/**)만 바꾼 푸시는 브라우저 하네스를 건너뛴다 — 하네스 결과를 바꾸지 않고,
# CI 가 그 워크플로로 어차피 돈다. verify 는 위에서 이미 돌았다.
if base="$(git rev-parse --verify -q origin/main)"; then
  # shellcheck disable=SC2086
  if node scripts/push-scope.mjs "$base" $shas; then
    printf '\033[33m⚠ origin/main 대비 바뀐 파일이 .github/** 뿐 — 브라우저 하네스를 건너뜁니다 (verify 는 통과).\033[0m\n'
    exit 0
  fi
fi

# 브라우저가 없으면 막지 말고 알려만 준다. 설치는 개발자의 선택이고 CI 가 받아낸다.
if ! node -e "import('./docs/qa/browser.mjs').then(m=>m.resolveHeadlessShell())" 2>/dev/null; then
  printf '\033[33m⚠ chrome-headless-shell 이 없어 브라우저 검증을 건너뜁니다.\033[0m\n'
  printf '  npx playwright install chromium-headless-shell\n'
  exit 0
fi

# 엄격 모드: 빌드가 dirty(커밋되지 않은 변경 포함)면 거부한다 — 보내는 것과 다른 것을 검사하지 않는다.
DS_QA_STRICT=1 pnpm -s qa || { printf '\n\033[31m✗ pnpm qa 실패 — 위 하네스 출력을 읽어라\033[0m\n'; exit 1; }
printf '\033[32m✓ pre-push 통과\033[0m\n'
