{
  "name": "@s2life/ui",
  "version": "0.3.0",
  "type": "module",
  "description": "S2Life B2B SaaS React 컴포넌트 — 토큰 기반, Tailwind v4",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./tokens.json": "./dist/tokens.json",
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./tailwind.css": "./dist/tailwind.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node ../../scripts/build-ui.mjs",
    "prepack": "pnpm build",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
