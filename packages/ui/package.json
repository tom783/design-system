    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom783/design-system.git",
    "directory": "packages/ui"
